# ---------------------------------------------------------------------------
# AI Chat (Spec 023). Required only when `aiChat.enabled: true` in works.yml.
# See docs/spec/023-ai-chat/ for the full feature spec.
# ---------------------------------------------------------------------------

# OpenAI-compatible API key (OpenRouter / OpenAI / Anthropic-via-OpenRouter / etc.).
# Server-only — never expose to the client.
AI_CHAT_API_KEY=

# Optional. Defaults to OpenRouter when unset.
# AI_CHAT_BASE_URL=https://openrouter.ai/api/v1

# Optional provider label (passed to createOpenAICompatible.name). Overrides works.yml.
# AI_CHAT_PROVIDER=openrouter

# Optional model id. Overrides works.yml `aiChat.model`.
# Default: `meta-llama/llama-3.3-70b-instruct:free` — an OpenRouter
# free-tier model ($0/month, rate-limited per account). Paid
# alternatives: `openai/gpt-4o-mini`, `anthropic/claude-haiku-4.5`.
# AI_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional rate-limit overrides (requests per 60s). Defaults: 20 anon / 60 authenticated.
# AI_CHAT_RATE_LIMIT_ANON=20
# AI_CHAT_RATE_LIMIT_AUTH=60

# E2E test override (Spec 023, T-013a). When set to `true` AND
# `NODE_ENV !== production`, a request that carries the
# `ai-chat-test-override` cookie with value `enabled` (or
# `E2E_TEST_OVERRIDE_TOKEN`) will see `aiChat.enabled=true` even when
# `works.yml` disables it. Never set in production.
# E2E_ALLOW_TEST_OVERRIDES=false
# E2E_TEST_OVERRIDE_TOKEN=enabled

# ===== Platform Activity Feed (EW-120) =====
# Contract between this directory site and the Ever Works platform. Both
# pull-mode (`/api/platform/activity-feed`) and push-mode (outbound
# emission to the platform's ingest endpoint) reuse `PLATFORM_WORK_ID`.
# Leave the rest blank to disable the corresponding half.
#
# UUID identifying this directory's Work on the platform. Used by both
# pull (HMAC payload includes it so a leaked secret can't be replayed
# against another Work) and push (sent as `workId` in the ingest body).
PLATFORM_WORK_ID=
#
# --- Pull mode (platform calls us) ---
# Per-Work HMAC secret used to verify incoming platform requests.
# Blank → `/api/platform/activity-feed` returns 503 (`not_provisioned`).
PLATFORM_SYNC_SECRET=
# Optional. Public base URL used to construct admin-panel click-throughs
# in feed responses. Defaults to the request origin when blank.
PLATFORM_ADMIN_BASE_URL=
#
# --- Push mode (we call the platform) ---
# Base URL of the Ever Works platform API (no trailing slash).
# Example: https://api.ever.works
PLATFORM_API_URL=
# Bearer token expected by the platform's `/api/activity-log/ingest`
# endpoint. Same value across all sites in the same platform tenant —
# the platform side calls this `PLATFORM_API_SECRET_TOKEN` too.
# Both PLATFORM_API_URL and PLATFORM_API_SECRET_TOKEN blank → outbound
# emission silently no-ops (no warnings in logs).
PLATFORM_API_SECRET_TOKEN=
