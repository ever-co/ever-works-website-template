	"scripts": {
		"dev": "node scripts/check-env.js --quick && cross-env NODE_OPTIONS='--max-old-space-size=8192' pnpm generate-docs && cross-env NODE_OPTIONS='--max-old-space-size=8192' next dev",
		"predev": "node scripts/clone.cjs",
		"generate-docs": "tsx scripts/generate-openapi.ts",
		"docs:watch": "nodemon --watch 'app/api/**/*.ts' --watch 'lib/payment/**/*.ts' --exec 'pnpm generate-docs'",
		"dev:check": "node scripts/check-env.js && next dev",
		"build": "node scripts/check-env.js && cross-env NODE_OPTIONS='--max-old-space-size=8192' pnpm generate-docs --silent && tsx scripts/build-migrate.ts && cross-env NODE_OPTIONS='--max-old-space-size=8192' next build",
		"build:ci": "node scripts/check-env-ci.js --silent && next build",
		"start": "node scripts/check-env.js --silent --quick && next start",
		"lint": "node scripts/lint.js",
		"test:unit": "tsx --test \"lib/**/*.spec.ts\" \"scripts/**/*.spec.ts\"",
		"prebuild": "node scripts/clone.cjs",
		"clean": "rm -rf .next node_modules",
		"check-env": "node scripts/check-env.js",
		"check-env:quick": "node scripts/check-env.js --quick",
		"check-env:silent": "node scripts/check-env.js --silent",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx scripts/cli-seed.ts",
		"db:migrate:cli": "tsx scripts/cli-migrate.ts"
	},
